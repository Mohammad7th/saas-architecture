{
  "name": "saas-architecture-challenge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "nx run-many -t dev --projects=@workspace/admin,@workspace/profile --parallel=2 --outputStyle=stream",
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "check:boundaries": "pnpm lint",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build",
    "lint": "nx run-many -t lint",
    "graph": "nx graph",
    "affected": "nx affected -t lint typecheck build",
    "dev:api": "nx run @workspace/mock-api:serve",
    "dev:admin": "nx dev @workspace/admin",
    "dev:profile": "nx dev @workspace/profile",
    "preview:admin": "nx preview @workspace/admin",
    "preview:profile": "nx preview @workspace/profile",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "lint:fix": "nx run-many -t lint -- --fix"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0",
    "typescript": "^5.9.0",
    "nx": "^22.0.0",
    "@nx/eslint-plugin": "^22.0.0",
    "@nx/devkit": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.6.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "@eslint/js": "^9.0.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0"
  },
  "packageManager": "pnpm@12.10.1",
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml,css,html}": "prettier --write"
  }
}
